[0.161, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[0.000, "o", ">>>Введите команду: "]
[8.881, "o", "create_table users name:str age:int is_active:bool"]
[0.415, "o", "\r\n"]
[0.000, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[0.002, "o", ">>>Введите команду: "]
[6.694, "o", "list_tables"]
[0.392, "o", "\r\n"]
[0.000, "o", "- users\r\n"]
[0.001, "o", ">>>Введите команду: "]
[10.357, "o", "drop_table users"]
[0.505, "o", "\r\n"]
[0.001, "o", "Таблица \"users\" успешно удалена.\r\n"]
[0.001, "o", ">>>Введите команду: "]
[7.390, "o", "exit"]
[0.394, "o", "\r\n"]
[0.009, "o", "\u001b[1m\u001b[7m%\u001b[27m\u001b[1m\u001b[0m                                                                                                                                                            \r \r"]
